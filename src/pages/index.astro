---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { services } from '../data/services';
import { projects } from '../data/projects';

const schema = { '@context': 'https://schema.org', '@type': 'ProfessionalService', name: site.name, description: site.description, url: site.url, founder: { '@type': 'Person', name: site.owner } };
---
<BaseLayout>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
  <a class="skip-link" href="#main">Skip to content</a>
  <div id="top" class="page-shell">
    <Header />
    <main id="main">
      <section class="hero" aria-labelledby="hero-heading">
        <img src="/images/hero-roomwright-feature.png" alt="A finished Roomwright interior with oak acoustic wall panelling, a dark feature wall and warm recessed lighting" width="1208" height="820" fetchpriority="high" />
        <div class="hero-overlay"></div>
        <div class="hero-content eyebrow-light">
          <p>Room design & installation</p>
          <h1 id="hero-heading">Beautiful rooms,<br />properly made.</h1>
          <p class="hero-copy">Designed, built and finished by Harrison. Roomwright takes a project from first idea through to the finished room.</p>
          <div class="actions"><a class="button button-light" href="#contact">Discuss your room</a><a class="text-link light" href="#projects">See previous work <span aria-hidden="true">&darr;</span></a></div>
        </div>
      </section>

      <section class="intro section" aria-labelledby="intro-heading">
        <div class="section-label">Roomwright approach</div>
        <div><h2 id="intro-heading">One person.<br />The whole project.</h2></div>
        <div class="intro-copy"><p>A successful room involves far more than fitting the visible pieces. Plumbing, electrics, walls, floors, lighting, storage and finishing all have to work together.</p><p>Harrison manages the complete transformation, helping turn an idea into a practical, carefully finished room, fitted-storage solution or outdoor space.</p></div>
      </section>

<section id="projects" class="projects section" aria-labelledby="projects-heading">
        <div class="section-heading"><div><p class="section-label">Selected work</p><h2 id="projects-heading">Rooms, storage<br />& spaces.</h2></div><p>Recent work across interiors, fitted furniture and outdoor living spaces &mdash; designed and made as complete, practical projects.</p></div>
        <div class="featured-project-grid">{projects.filter((project) => ["fitted-wardrobe-storage", "bespoke-outbuilding-bar", "outbuilding-deck-lighting"].includes(project.slug)).map((project) => <article class="project-card featured-project"><button class="project-image" type="button" data-lightbox-src={project.images[0]} data-lightbox-alt={project.title} aria-label={`View ${project.title} larger`}><img src={project.images[0]} alt={project.title} width="1200" height="900" loading="lazy" /></button>{project.images.length > 1 && <div class="project-thumbnails" aria-label={`${project.title} gallery`}>{project.images.slice(1).map((image, index) => <button type="button" data-lightbox-src={image} data-lightbox-alt={`${project.title} ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â installation stage ${index + 1}`} aria-label={`View ${project.title} installation stage ${index + 1} larger`}><img src={image} alt={`${project.title} installation stage ${index + 1}`} width="900" height="675" loading="lazy" /></button>)}</div>}<div><p class="project-kicker">Recent project</p><h3>{project.title}</h3>{project.description && <p>{project.description}</p>}</div></article>)}</div>
        <div class="portfolio-divider"><p class="section-label">Interior transformations</p><h3 id="rooms-heading">Bathrooms & room details.</h3><p>The same care applied to the layout, storage, lighting and finishing touches inside the home.</p></div>
        <div class="project-grid">{projects.filter((project) => !["fitted-wardrobe-storage", "bespoke-outbuilding-bar", "outbuilding-deck-lighting"].includes(project.slug)).map((project) => <article class="project-card"><button class="project-image" type="button" data-lightbox-src={project.images[0]} data-lightbox-alt={project.title} aria-label={`View ${project.title} larger`}><img src={project.images[0]} alt={project.title} width="900" height="1125" loading="lazy" /></button><div><h3>{project.title}</h3>{project.description && <p>{project.description}</p>}</div></article>)}</div>
      </section>

      <section id="services" class="services section" aria-labelledby="services-heading">
        <div class="section-heading"><div><p class="section-label">What Roomwright does</p><h2 id="services-heading">Everything the room needs.</h2></div><p>Each part is considered as part of one complete job, not as a list of separate trades.</p></div>
        <div class="service-grid">{services.map(([title, description], index) => <article class="service-card"><span>{String(index + 1).padStart(2, '0')}</span><h3>{title}</h3><p>{description}</p></article>)}</div>
      </section>

      <section class="process section tone" aria-labelledby="process-heading">
        <div class="section-heading"><div><p class="section-label">A clear process</p><h2 id="process-heading">From idea to finished room.</h2></div></div>
        <ol class="steps"><li><span>01</span><h3>Talk</h3><p>Discuss the existing room, ideas, priorities and budget.</p></li><li><span>02</span><h3>Design</h3><p>Develop a practical layout and agree fixtures, finishes and details.</p></li><li><span>03</span><h3>Build</h3><p>Prepare the existing space and carry out the installation.</p></li><li><span>04</span><h3>Finish</h3><p>Complete the tiling, fittings, details and final checks.</p></li></ol>
      </section>

      <section id="advice" class="advice-preview section" aria-labelledby="advice-heading">
        <div class="section-heading"><div><p class="section-label">Roomwright advice</p><h2 id="advice-heading">Helpful detail,<br />coming soon.</h2></div><p>Practical notes on planning, materials and the details that help a room work well are being prepared.</p></div>
        <div class="advice-coming-soon"><p class="section-label">In preparation</p><p>Useful, plain-English guidance will live here soon &mdash; without turning your project into a technical exercise.</p></div>
      </section>      <section class="project-details section" aria-labelledby="project-details-heading"><div class="section-heading"><div><p class="section-label">Project details</p><h2 id="project-details-heading">Made to work<br />as one room.</h2></div><p>Storage, lighting, tiling and fittings brought together in a compact ensuite installation.</p></div><div class="comparison"><figure><figcaption>Shower detail</figcaption><img src="/images/kingshill-rougemont/PXL_20251213_142948914.jpg" alt="Walk-in shower with a recessed storage niche" width="6144" height="8160" loading="lazy" /></figure><figure><figcaption>Basin detail</figcaption><img src="/images/kingshill-rougemont/PXL_20251213_143733288.jpg" alt="Wall-mounted basin below an illuminated mirrored cabinet" width="5358" height="6922" loading="lazy" /></figure></div></section>

      <section class="why section dark" aria-labelledby="why-heading"><div><p class="section-label">Why Roomwright</p><h2 id="why-heading">More than<br />one trade.</h2></div><div><p class="lead">A room, fitted-storage or outdoor project brings several different trades and decisions together. Roomwright treats them as one job and one finished result.</p><ul><li>One point of contact</li><li>Design and installation considered together</li><li>Attention to the small details</li><li>Practical solutions for awkward spaces</li><li>A clean, coordinated finish</li></ul></div></section>

      <section id="about" class="about section" aria-labelledby="about-heading"><div class="about-image"><img src="/images/harrison-portrait.png" alt="Harrison, founder of Roomwright" width="1208" height="820" loading="lazy" /></div><div class="about-copy"><p class="section-label">The person behind Roomwright</p><h2 id="about-heading">Harrison</h2><p>Roomwright is Harrison's room design and installation service. From planning the layout to completing the finishing touches, Harrison takes a hands-on approach to creating kitchens, bathrooms, cloakrooms and other spaces that work properly and look right.</p><a class="text-link" href="#contact">Send a message <span aria-hidden="true">&rarr;</span></a></div></section>

      <section id="contact" class="contact section tone" aria-labelledby="contact-heading"><div><p class="section-label">Start a conversation</p><h2 id="contact-heading">Thinking about<br />a new room?</h2><p>Whether you already know exactly what you want or are starting with a room that simply isn't working, send a message and tell Harrison what you have in mind.</p></div><form class="enquiry-form" action="/api/enquiry" method="post" data-enquiry-form><div class="honeypot" aria-hidden="true"><label>Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label></div><label>Name<input name="name" autocomplete="name" required /></label><label>Email<input name="email" type="email" autocomplete="email" required /></label><label>Telephone <small>optional</small><input name="telephone" type="tel" autocomplete="tel" /></label><label>Postcode <small>optional</small><input name="postcode" autocomplete="postal-code" /></label><label>Tell Harrison about your room<textarea name="message" rows="5" required placeholder="A little about the room, what you would like to change, and anything else that may help."></textarea></label><div class="verification-field" data-turnstile-widget></div><button type="submit">Send message <span aria-hidden="true">&rarr;</span></button><div class="form-status" aria-live="polite"></div></form></section>    </main>
    <Footer />
  </div>
  <a class="mobile-email" href="#contact">Email Harrison</a>
  <dialog class="lightbox" aria-label="Project image viewer"><button class="lightbox-close" aria-label="Close image viewer">&times;</button><img src="" alt="" /></dialog>
  <script is:inline>
    window.onRoomwrightTurnstileLoaded = () => window.dispatchEvent(new Event('roomwright-turnstile-ready'));
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onRoomwrightTurnstileLoaded" async defer></script>
  <script>
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
    const image = dialog?.querySelector('img');
    document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach((button) => button.addEventListener('click', () => { if (dialog && image) { image.src = button.dataset.lightboxSrc || ''; image.alt = button.dataset.lightboxAlt || ''; dialog.showModal(); } }));
    dialog?.querySelector('.lightbox-close')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });

    const enquiryForm = document.querySelector<HTMLFormElement>('[data-enquiry-form]');
    const formStatus = enquiryForm?.querySelector<HTMLElement>('.form-status');
    const submitButton = enquiryForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const turnstileWidget = enquiryForm?.querySelector<HTMLElement>('[data-turnstile-widget]');
    let turnstileSitekey = '';
    let turnstileWidgetId: string | null = null;

    const setFormStatus = (message: string, success = false) => {
      if (!formStatus) return;
      formStatus.classList.toggle('success', success);
      formStatus.textContent = message;
    };
    const getTurnstile = () => {
      const value = Reflect.get(window, 'turnstile') as { render?: (element: HTMLElement, options: Record<string, unknown>) => string; reset?: (id: string) => void } | undefined;
      return value && typeof value.render === 'function' && typeof value.reset === 'function' ? { render: value.render, reset: value.reset } : null;
    };
    const renderTurnstile = () => {
      const turnstile = getTurnstile();
      if (!turnstile || !turnstileWidget || !turnstileSitekey || turnstileWidgetId) return;
      turnstileWidgetId = turnstile.render(turnstileWidget, { sitekey: turnstileSitekey, action: 'enquiry', theme: 'light' });
    };
    const resetTurnstile = () => {
      const turnstile = getTurnstile();
      if (turnstile && turnstileWidgetId) turnstile.reset(turnstileWidgetId);
    };
    const disableForm = () => {
      if (submitButton) submitButton.disabled = true;
      setFormStatus('The message form is temporarily unavailable. Please try again later.');
    };
    const loadTurnstileSitekey = async () => {
      try {
        const response = await fetch('/api/turnstile-sitekey', { headers: { Accept: 'application/json' } });
        const result = await response.json() as { sitekey?: string };
        if (!response.ok || !result.sitekey) throw new Error();
        turnstileSitekey = result.sitekey;
        renderTurnstile();
      } catch {
        disableForm();
      }
    };

    window.addEventListener('roomwright-turnstile-ready', renderTurnstile);
    loadTurnstileSitekey();

    enquiryForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (enquiryForm.querySelector<HTMLInputElement>('[name="website"]')?.value) return;
      const formData = new FormData(enquiryForm);
      if (!formData.get('cf-turnstile-response')) {
        setFormStatus('Please complete the verification check.');
        return;
      }
      if (submitButton) submitButton.disabled = true;
      setFormStatus('Sending your message...');
      try {
        const response = await fetch(enquiryForm.action, { method: 'POST', body: formData, headers: { Accept: 'application/json' } });
        const result = await response.json() as { error?: string };
        if (!response.ok) throw new Error(result.error || 'We could not send your message.');
        enquiryForm.reset();
        setFormStatus('Thank you. Your message has been sent.', true);
      } catch (error) {
        setFormStatus(error instanceof Error ? error.message : 'We could not send your message. Please try again later.');
      } finally {
        if (submitButton) submitButton.disabled = false;
        resetTurnstile();
      }
    });
  </script>
</BaseLayout>
