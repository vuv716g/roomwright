---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
---
<BaseLayout title="Room Advice & Guides | Roomwright" description="Straightforward advice from Roomwright on the practical decisions behind a well-designed, properly installed room.">
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <section class="page-intro section" aria-labelledby="advice-heading"><p class="section-label">Roomwright advice</p><h1 id="advice-heading">Room advice,<br />properly explained.</h1><p>Useful, plain-English notes on the details behind a carefully planned room. Enough to make decisions clearer, without turning your project into a technical exercise.</p></section>
    <section class="guides-list section tone" aria-labelledby="coming-soon-heading"><div class="advice-coming-soon"><p class="section-label">In preparation</p><h2 id="coming-soon-heading">Advice is coming soon.</h2><p>Practical, plain-English notes on the decisions behind a carefully planned room will be added here soon.</p><a class="text-link" href="/#contact">Send a message <span aria-hidden="true">â†’</span></a></div></section>
  </main>
  <Footer />
  <style>
    .page-intro { max-width:70rem; padding-top:clamp(4.5rem,10vw,9rem); } .page-intro h1 { font-size:clamp(3rem,6vw,6rem); } .page-intro > p:last-child { max-width:39rem; font-size:1.12rem; } 
  </style>
</BaseLayout>
