---
import { emailHref, site } from '../config/site';
---
<header class="advice-header">
  <a class="wordmark" href="/" aria-label={`${site.name} home`}>Room<span>wright</span></a>
  <nav aria-label="Primary navigation">
    <a href="/#services">Services</a><a href="/#projects">Work</a><a href="/#about">About</a><a href="/advice/">Advice</a>
    <a class="nav-contact" href={emailHref}>Contact</a>
  </nav>
</header>
<style>
  .advice-header { display:flex; align-items:center; justify-content:space-between; padding:1.5rem clamp(1.25rem,4vw,4.5rem); color:var(--ink); }
  @media (max-width:800px) { .advice-header { padding:1.25rem; } .advice-header nav a:not(.nav-contact) { display:none; } }
</style>
